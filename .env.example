# Copy to .env.local for local work, and set the same names in Vercel.
# Server-side only. None of these may ever start with NEXT_PUBLIC_.

# Supabase project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=

# Supabase secret key (the "service_role" / "secret" key). Server only.
SUPABASE_SERVICE_ROLE_KEY=

# The family's IANA time zone, e.g. Asia/Manila
TIMEZONE=

# Web Push (reminders). Generate a pair with: npx web-push generate-vapid-keys
# The public key is public by design, so it is the one allowed NEXT_PUBLIC_ value.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# The private key is a secret. Server only.
VAPID_PRIVATE_KEY=
# Who is sending: a URL for the app (never a personal email address).
VAPID_SUBJECT=

# Secret that lets the scheduler call /api/send-reminders. Server only.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The same value goes into supabase/sql/005-schedule-reminders.sql when you run it.
REMINDER_CRON_SECRET=
